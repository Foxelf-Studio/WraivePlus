# Add project specific R8 rules here.
# AGP will combine all keep rule files in src/main/keepRules to pass to R8
#
# For more details, see
#   https://d.android.com/r/tools/r8/keep-rules

# ---------------------------------------------------------------------------
# Gson persistence
# ---------------------------------------------------------------------------
# Providers, models, assistants, conversations, messages and settings are all
# stored as Gson JSON and read back by *field name*. R8 renames fields by
# default, so a release build could not read data written by a debug build:
# provider.id came back null and refreshProviders() crashed the process on the
# first launch. Keep the whole persisted model package verbatim.
-keep class moye.wear.wraive.model.** { *; }

# Payload classes that Gson serializes but that live outside the model package.
-keep class moye.wear.wraive.data.ChatDraft { *; }
-keep class moye.wear.wraive.data.CloudSecrets { *; }
-keep class moye.wear.wraive.data.RepositorySnapshot { *; }
-keep class moye.wear.wraive.data.BackupService$BackupBundle { *; }

# Gson reflects over generic signatures (List<Attachment>, Map<String, Any?>)
# and reads @SerializedName at runtime; both must survive shrinking.
-keepattributes Signature
-keepattributes *Annotation*
-keepattributes InnerClasses
-keepattributes EnclosingMethod

# TypeToken subclasses capture the generic type; keep them and their signatures.
-keep class com.google.gson.reflect.TypeToken { *; }
-keep class * extends com.google.gson.reflect.TypeToken

# Preserve SDK calls so the device's Wear implementation wins class loading.
-keep class com.google.wear.input.WearHapticFeedbackConstants {
    public static int getScrollItemFocus();
    public static int getScrollTick();
    public static int getScrollLimit();
}
